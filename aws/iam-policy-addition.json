{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3StaticSitesManage",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:DeleteBucket",
        "s3:PutBucketPolicy", "s3:GetBucketPolicy", "s3:DeleteBucketPolicy",
        "s3:PutBucketOwnershipControls", "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging", "s3:PutEncryptionConfiguration",
        "s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::quipu-smartsnippet-web",
        "arn:aws:s3:::quipu-smartsnippet-web/*",
        "arn:aws:s3:::quipu-dls-web",
        "arn:aws:s3:::quipu-dls-web/*"
      ]
    },
    {
      "Sid": "LambdaManageDlsSyncFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction", "lambda:UpdateFunctionCode", "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction", "lambda:AddPermission", "lambda:RemovePermission",
        "lambda:InvokeFunction", "lambda:DeleteFunction", "lambda:TagResource",
        "lambda:ListTags", "lambda:PublishVersion", "lambda:GetPolicy"
      ],
      "Resource": "arn:aws:lambda:*:873775216030:function:dls-tracker-*"
    },
    {
      "Sid": "IamRoleForDlsTrackerOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:GetRole", "iam:PutRolePolicy", "iam:AttachRolePolicy",
        "iam:PassRole", "iam:DeleteRole", "iam:DeleteRolePolicy", "iam:DetachRolePolicy", "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::873775216030:role/dls-tracker-*"
    },
    {
      "Sid": "SchedulerForDlsSync",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule", "scheduler:GetSchedule", "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule", "scheduler:ListSchedules", "scheduler:TagResource"
      ],
      "Resource": "arn:aws:scheduler:*:873775216030:schedule/*/dls-tracker-*"
    }
  ]
}
